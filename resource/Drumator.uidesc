{
  "vstgui-ui-description": {
    "version": "1",
    "variables": {},
    "bitmaps": {},
    "fonts": {},
    "colors": {},
    "control-tags": {},
    "templates": {
      "DrumatorView": {
        "attributes": {
          "class": "CViewContainer",
          "origin": "0, 0",
          "size": "1100, 300",
          "transparent": "false",
          "mouse-enabled": "true",
          "background-color": "~ BlackCColor",
          "minSize": "1100, 300",
          "maxSize": "1100, 650"
        },
        "children": {
          "CView": {
            "attributes": {
              "class": "CView",
              "custom-view-name": "DrumatorStepGrid",
              "origin": "0, 0",
              "size": "1100, 300",
              "mouse-enabled": "true",
              "transparent": "false"
            }
          }
        }
      }
    }
  }
}